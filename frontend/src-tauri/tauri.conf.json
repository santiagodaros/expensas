{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Gestor de Consorcios",
    "version": "2.5.1",
    "identifier": "com.expensas.gestor",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Gestor de Consorcios",
                "width": 1280,
                "height": 800,
                "minWidth": 960,
                "minHeight": 600,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0Mzc4MTcxNUZBRkU2MEIKUldRTDVxOWZjWUUzRkgrQ29HMnRNWlRuTUVVODJsd1FPdmtJWTIxNU5yOUNoUUF2TkpWTTRrUnMK",
            "endpoints": [
                "https://github.com/santiagodaros/expensas/releases/latest/download/latest.json"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "externalBin": [
            "binaries/api-server"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "allowDowngrades": true,
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}