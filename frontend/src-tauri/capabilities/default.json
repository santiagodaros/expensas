{
    "$schema":  "../gen/schemas/desktop-schema.json",
    "identifier":  "default",
    "description":  "Capability for the main window",
    "windows":  [
                    "main"
                ],
    "permissions":  [
                        "core:default",
                        "opener:default",
                        "shell:allow-execute",
                        "shell:allow-kill",
                        "updater:default",
                        "process:allow-relaunch",
                        {
                            "identifier": "http:default",
                            "allow": [
                                { "url": "http://127.0.0.1:*" },
                                { "url": "http://localhost:*" }
                            ]
                        }
                    ]
}